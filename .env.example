NODE_ENV=production
PORT=3000
APP_ROLE=all
ADMIN_TELEGRAM_IDS=123456789

DATABASE_URL=postgresql://user:password@127.0.0.1:5432/lumio
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

TELEGRAM_BOT_TOKEN=replace_me

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace_me
AI_OUTLINE_MODEL=openai/gpt-4.1
AI_CARD_MODEL=openai/gpt-5.4-mini
AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_TTL_SEC=604800
AI_REQUEST_TIMEOUT_MS=45000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DAILY=10
GENERATION_LOCK_TTL_SEC=1800
GENERATION_GLOBAL_CONCURRENCY=1

RENDER_ENGINE=legacy
