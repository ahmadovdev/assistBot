      "content": {
        "items": [
          {
            "icon": "money",
            "text": "Bu kundalik moliyaviy boshqaruv, ya'ni budjet tuzish, xarajatlarni nazorat qilish va jamg‘arma ko‘nikmalarini o‘z ichiga oladi.",
            "label": "Shaxsiy moliyaviy savodxonlik"
